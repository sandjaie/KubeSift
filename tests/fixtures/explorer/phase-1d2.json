{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "kubesift-restart-check",
        "labels": {
          "kubesift.dev/fixture": "phase1d2-validation"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "restart-headless",
        "namespace": "kubesift-restart-check"
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "kubesift.dev/controller": "stateful"
        },
        "ports": [
          {
            "port": 80
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "reviewed-deployment",
        "namespace": "kubesift-restart-check"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "reviewed-deployment"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "reviewed-deployment"
            },
            "annotations": {
              "kubesift.dev/sibling": "retained"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 1,
            "containers": [
              {
                "name": "pause",
                "image": "registry.k8s.io/pause:3.10",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "1m",
                    "memory": "2Mi"
                  },
                  "limits": {
                    "memory": "16Mi"
                  }
                }
              }
            ]
          }
        },
        "replicas": 1
      }
    },
